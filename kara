<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Gift For You</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            background: linear-gradient(to bottom, #0a1128, #1c2541, #3a506b);
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        .snowflake {
            position: absolute;
            top: -10px;
            color: rgba(255, 255, 255, 0.8);
            font-size: 1em;
            user-select: none;
            pointer-events: none;
            animation: fall linear infinite;
        }

        @keyframes fall {
            to {
                transform: translateY(100vh) rotate(360deg);
            }
        }

        .container {
            text-align: center;
            padding: 2rem;
            max-width: 600px;
            position: relative;
            z-index: 10;
        }

        .message {
            font-size: 2rem;
            margin: 1.5rem 0;
            opacity: 0;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
        }

        .message.fade-in {
            animation: fadeIn 1.5s ease-in forwards;
        }

        @keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        .greeting {
            font-size: 2.5rem;
            font-weight: bold;
            color: #ffd700;
        }

        .tease-text {
            font-size: 1.5rem;
            font-style: italic;
            color: #e8e8e8;
        }

        .unwrap-btn {
            display: none;
            margin: 3rem auto;
            padding: 1rem 3rem;
            font-size: 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 50px;
            color: white;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
            transition: all 0.3s ease;
            animation: fadeIn 1s ease-in forwards, pulse 2s ease-in-out infinite;
        }

        .unwrap-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.6);
        }

        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
            }
            50% {
                box-shadow: 0 10px 50px rgba(102, 126, 234, 0.7);
            }
        }

        .gift-box {
            display: none;
            font-size: 8rem;
            margin: 2rem 0;
            animation: giftShake 0.5s ease-in-out;
        }

        @keyframes giftShake {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-5deg); }
            75% { transform: rotate(5deg); }
        }

        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 100;
        }

        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            opacity: 0;
        }

        @keyframes confettiFall {
            0% {
                transform: translateY(0) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(720deg);
                opacity: 0;
            }
        }

        .reveal-text {
            display: none;
            font-size: 2.5rem;
            font-weight: bold;
            color: #ffd700;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
            animation: fadeIn 1s ease-in forwards;
            margin: 2rem 0;
        }

        .amount {
            font-size: 3.5rem;
            color: #ff6b9d;
            text-shadow: 0 0 40px rgba(255, 107, 157, 0.6);
        }

        .signature {
            display: none;
            font-size: 1.8rem;
            font-style: italic;
            color: #ffd700;
            margin-top: 3rem;
            animation: fadeIn 1.5s ease-in forwards;
        }

        .sparkle {
            position: absolute;
            pointer-events: none;
            font-size: 1.5rem;
            opacity: 0;
        }

        @keyframes sparkleTrail {
            0% {
                opacity: 0;
                transform: scale(0);
            }
            50% {
                opacity: 1;
                transform: scale(1.5);
            }
            100% {
                opacity: 0;
                transform: scale(0) translateX(100px);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="message greeting fade-in">Merry Christmas, Kara!</div>
        <div class="message tease-text" id="tease1">This gift cannot fit in a box.</div>
        <div class="message tease-text" id="tease2">Because it is a journey.</div>
        <button class="unwrap-btn" id="unwrapBtn">✨ Tap to unwrap ✨</button>
        <div class="gift-box" id="giftBox">🎁</div>
        <div class="reveal-text" id="revealText">
            You are getting a<br>
            <span class="amount">$50</span><br>
            shopping spree!
        </div>
        <div class="signature" id="signature">Love, Mom 💝</div>
    </div>

    <div class="confetti-container" id="confettiContainer"></div>

    <script>
        // Snowfall effect
        function createSnowflake() {
            const snowflake = document.createElement('div');
            snowflake.classList.add('snowflake');
            snowflake.textContent = '❄';
            snowflake.style.left = Math.random() * 100 + '%';
            snowflake.style.animationDuration = (Math.random() * 3 + 5) + 's';
            snowflake.style.opacity = Math.random() * 0.6 + 0.4;
            snowflake.style.fontSize = (Math.random() * 0.5 + 0.5) + 'em';
            document.body.appendChild(snowflake);

            setTimeout(() => {
                snowflake.remove();
            }, 8000);
        }

        setInterval(createSnowflake, 200);

        // Create sparkle trail
        function createSparkle() {
            const sparkle = document.createElement('div');
            sparkle.classList.add('sparkle');
            sparkle.textContent = '✨';
            sparkle.style.left = Math.random() * 100 + '%';
            sparkle.style.top = Math.random() * 100 + '%';
            sparkle.style.animation = 'sparkleTrail 2s ease-out forwards';
            document.body.appendChild(sparkle);

            setTimeout(() => {
                sparkle.remove();
            }, 2000);
        }

        // Sequence animation
        setTimeout(() => {
            document.getElementById('tease1').classList.add('fade-in');
            createSparkle();
        }, 2000);

        setTimeout(() => {
            document.getElementById('tease2').classList.add('fade-in');
            createSparkle();
        }, 4000);

        setTimeout(() => {
            document.getElementById('unwrapBtn').style.display = 'block';
        }, 6000);

        // Unwrap button click
        document.getElementById('unwrapBtn').addEventListener('click', function() {
            this.style.display = 'none';
            
            // Hide tease messages
            document.querySelectorAll('.tease-text').forEach(el => {
                el.style.display = 'none';
            });

            // Show and animate gift box
            const giftBox = document.getElementById('giftBox');
            giftBox.style.display = 'block';

            // Create confetti
            setTimeout(() => {
                createConfetti();
                giftBox.style.animation = 'giftShake 0.5s ease-in-out, fadeIn 0.5s ease-out reverse';
                
                setTimeout(() => {
                    giftBox.style.display = 'none';
                    document.getElementById('revealText').style.display = 'block';
                    
                    setTimeout(() => {
                        document.getElementById('signature').style.display = 'block';
                    }, 1500);
                }, 800);
            }, 500);
        });

        function createConfetti() {
            const colors = ['#ff6b9d', '#ffd700', '#667eea', '#764ba2', '#f093fb', '#4facfe'];
            const confettiContainer = document.getElementById('confettiContainer');
            
            for (let i = 0; i < 80; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.classList.add('confetti');
                    confetti.style.left = Math.random() * 100 + '%';
                    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.animationDuration = (Math.random() * 2 + 3) + 's';
                    confetti.style.animationDelay = Math.random() * 0.5 + 's';
                    confetti.style.animation = 'confettiFall ' + (Math.random() * 2 + 3) + 's ease-out forwards';
                    confettiContainer.appendChild(confetti);

                    setTimeout(() => {
                        confetti.remove();
                    }, 5000);
                }, i * 30);
            }
        }
    </script>
</body>
</html>
